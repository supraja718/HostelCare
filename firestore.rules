rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role & Hostel Access
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isManagement() {
      return request.auth != null && getUserData().role == 'MANAGEMENT' && getUserData().status == 'ACTIVE';
    }

    function isWardenForHostel(hostelId) {
      return request.auth != null && getUserData().role == 'WARDEN' && getUserData().hostelId == hostelId && getUserData().status == 'ACTIVE';
    }

    function isStudentCareForHostel(hostelId) {
      return request.auth != null && getUserData().role == 'STUDENT_CARE' && (hostelId in getUserData().hostelAccess) && getUserData().status == 'ACTIVE';
    }

    function isStudentOwner(studentUid) {
      return request.auth != null && request.auth.uid == studentUid && getUserData().status == 'ACTIVE';
    }

    function isAssignedServiceStaff(staffUid) {
      return request.auth != null && request.auth.uid == staffUid && getUserData().role == 'SERVICE_STAFF' && getUserData().status == 'ACTIVE';
    }

    // 1. Central Users Collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isManagement();
    }

    // 2. Complaints Collection
    match /complaints/{complaintId} {
      allow read: if isManagement()
                  || isWardenForHostel(resource.data.hostelId)
                  || isStudentCareForHostel(resource.data.hostelId)
                  || isStudentOwner(resource.data.studentUid)
                  || isAssignedServiceStaff(resource.data.assignedStaffUid);

      allow create: if isStudentOwner(request.resource.data.studentUid);

      allow update: if isManagement()
                    || isWardenForHostel(resource.data.hostelId)
                    || (isAssignedServiceStaff(resource.data.assignedStaffUid) && request.resource.data.resolutionProof != null);
    }

    // 3. Outpasses Collection
    match /outpasses/{outpassId} {
      allow read: if isManagement()
                  || isWardenForHostel(resource.data.hostelId)
                  || isStudentOwner(resource.data.studentUid);

      allow create: if isStudentOwner(request.resource.data.studentUid);

      allow update: if isManagement() || isWardenForHostel(resource.data.hostelId);
    }

    // 4. Hospital Visits Collection
    match /hospital_visits/{visitId} {
      allow read: if isManagement()
                  || isWardenForHostel(resource.data.hostelId)
                  || isStudentOwner(resource.data.studentUid);

      allow create: if isStudentOwner(request.resource.data.studentUid);

      allow update: if isManagement() || isWardenForHostel(resource.data.hostelId);
    }

    // 5. Mess Menu Collection
    match /mess_menu/{menuId} {
      allow read: if request.auth != null;
      allow write: if isManagement() || isWardenForHostel(resource.data.hostelId);
    }

    // 6. Announcements Collection
    match /announcements/{announcementId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isManagement() || isWardenForHostel(request.resource.data.hostelId);
    }
  }
}
